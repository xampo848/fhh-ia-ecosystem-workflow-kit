{
  "$schema": "./manifest.schema.json",
  "schema_version": "2.0.0",
  "name": "fhh-ia-ecosystem-workflow-kit",
  "kit_version": "0.21.0-project-runbooks",
  "description": "Closed list of the paths the workflow kit owns in a target repository. A path belongs to the kit only when an entry below covers it; everything under project_root belongs to the project. The most specific entry wins.",
  "contract": ".agents/kit-boundary.md",
  "project_root": ".agents/project/",
  "classes": {
    "kit": "The kit owns the whole file; a kit update replaces it.",
    "derived": "The kit generates the file from its own sources (catalogs, wrappers, rendered agents).",
    "adapter": "The kit owns only the block between the entry's markers; text outside the block belongs to the project.",
    "seed": "The kit creates the file once when it is missing; after that the project owns it.",
    "state": "Install state written by the workflow-kit CLI."
  },
  "paths": [
    { "path": ".agents/README.md", "class": "kit" },
    { "path": ".agents/instructions.md", "class": "kit" },
    { "path": ".agents/kit-boundary.md", "class": "kit" },
    { "path": ".agents/capabilities/", "class": "kit" },
    { "path": ".agents/delegation/", "class": "kit" },
    { "path": ".agents/integrations/", "class": "kit" },
    { "path": ".agents/memory/", "class": "kit" },
    { "path": ".agents/model-routing/", "class": "kit" },
    { "path": ".agents/skills/", "class": "kit" },
    { "path": ".agents/skills/index.md", "class": "derived" },
    { "path": ".agents/skills/registry.json", "class": "derived" },
    { "path": ".agents/skills/registry.cache.json", "class": "derived" },
    { "path": ".agents/skills/06-patterns/index.md", "class": "derived" },
    { "path": ".agents/workflow-kit/manifest.json", "class": "kit" },
    { "path": ".agents/workflow-kit/manifest.schema.json", "class": "kit" },
    { "path": ".agents/workflow-kit/install-state.json", "class": "state", "generated": true },
    { "path": ".agents/workflow-kit/diagnostics/", "class": "state", "generated": true },
    { "path": ".agents/project/context.md", "class": "seed" },
    { "path": ".agents/project/quality-gate.md", "class": "seed" },
    { "path": ".agents/project/backend.md", "class": "seed" },
    { "path": ".agents/project/frontend.md", "class": "seed" },
    { "path": ".agents/project/paths.json", "class": "seed" },
    { "path": ".agents/project/stack.md", "class": "seed", "generated": true },
    { "path": "docs/workflow/", "class": "kit" },
    { "path": "docs/workflow/migration/legacy-docs-map.md", "class": "seed", "generated": true },
    { "path": "docs/README.md", "class": "adapter", "block": "workflow-kit:docs-workflow" },
    { "path": "AGENTS.md", "class": "adapter" },
    { "path": "CLAUDE.md", "class": "adapter" },
    { "path": "ANTIGRAVITY.md", "class": "adapter" },
    { "path": ".github/copilot-instructions.md", "class": "adapter" },
    { "path": ".github/instructions/ai-workflow.instructions.md", "class": "adapter" },
    { "path": ".github/instructions/", "class": "derived", "generated": true },
    { "path": ".github/agents/", "class": "derived" },
    { "path": ".claude/agents/", "class": "derived" },
    { "path": ".claude/skills/", "class": "derived" },
    { "path": ".codex/agents/", "class": "derived" },
    { "path": ".codex/README.md", "class": "kit" },
    { "path": ".antigravity/README.md", "class": "kit" }
  ],
  "project_layout": [
    ".agents/project/index.md",
    ".agents/project/routing.md",
    ".agents/project/skills/",
    ".agents/project/extensions/",
    ".agents/project/shadows/",
    ".agents/project/context.md",
    ".agents/project/quality-gate.md",
    ".agents/project/backend.md",
    ".agents/project/frontend.md",
    ".agents/project/stack.md",
    ".agents/project/paths.json"
  ],
  "legacy_paths": {
    ".agents/project-context.md": ".agents/project/context.md"
  },
  "extension_points": {
    "workflow-router": ".agents/project/routing.md",
    "instructions": ".agents/project/routing.md",
    "quality-gate": ".agents/project/quality-gate.md"
  },
  "not_shadowable": [
    "workflow-router",
    "instructions"
  ],
  "ignore_entries": [
    ".ai-work/",
    "/.agents/workflow-kit/last-apply.json"
  ],
  "superseded_seeds": {
    ".agents/project/quality-gate.md": [
      "c44ad4dacdbfd50134a830b982e47c345d8c3f58ee1e43d0e137a47dbdaa36f6",
      "f1be609d63476ba6d1bfdd5d803fa4269e53f33a1b6e4946a7996c1a2a5353a8"
    ]
  },
  "excluded_from_distribution": [
    "docs/epics/",
    "docs/prd/",
    "docs/internal-documentation/"
  ],
  "validation_commands": [
    "workflow-kit doctor --target <repo>",
    "npm run check:workflow (in the workflow-kit source repository)"
  ]
}
