{
  "description": "Rules that left the stack-neutral workflow skills (roadmap D-30). Each one must be present in the named stack pack so a project that installs the pack keeps exactly the same rules; scripts/validate-stack-neutrality.mjs enforces it.",
  "pack": "rails-react",
  "rules": [
    { "id": "services-base", "movedFrom": "backend-phase-implementer", "packPattern": "Services inherit from `BaseService`" },
    { "id": "thin-models", "movedFrom": "backend-phase-implementer", "packPattern": "Models only include validations, relationships, and simple scopes" },
    { "id": "cancancan", "movedFrom": "backend-phase-implementer", "packPattern": "Use CanCanCan\\. Do not introduce Pundit" },
    { "id": "acts-as-tenant", "movedFrom": "backend-phase-implementer", "packPattern": "Respect `acts_as_tenant`" },
    { "id": "backend-locales", "movedFrom": "backend-phase-implementer", "packPattern": "backend/config/locales/es\\.yml" },
    { "id": "minitest-not-rspec", "movedFrom": "backend-phase-implementer, create-prd", "packPattern": "Use Minitest, not RSpec" },
    { "id": "enumerate-it", "movedFrom": "create-prd", "packPattern": "`enumerate_it` conventions" },
    { "id": "english-identifiers", "movedFrom": "create-prd", "packPattern": "DB column names and Ruby variables use English identifiers" },
    { "id": "frontend-locales", "movedFrom": "frontend-phase-implementer", "packPattern": "front/src/i18n/locales/es\\.json" },
    { "id": "tanstack-query", "movedFrom": "frontend-phase-implementer", "packPattern": "TanStack Query v5 for server state" },
    { "id": "zustand", "movedFrom": "frontend-phase-implementer", "packPattern": "Zustand only for cross-feature client state" },
    { "id": "formik-yup", "movedFrom": "frontend-phase-implementer", "packPattern": "Formik \\+ Yup" },
    { "id": "vitest-testing-library", "movedFrom": "frontend-phase-implementer, acceptance-test-engineer", "packPattern": "Vitest \\+ Testing Library" },
    { "id": "bullet-n-plus-one", "movedFrom": "acceptance-test-engineer", "packPattern": "`Bullet` must be active in tests" },
    { "id": "msw-mocks", "movedFrom": "acceptance-test-engineer", "packPattern": "Mock every network request with MSW" },
    { "id": "make-test-fast", "movedFrom": "validation-and-stop-conditions, backend-phase-implementer, validation-runner", "packPattern": "`make test-fast`" },
    { "id": "make-tests-run", "movedFrom": "validation-and-stop-conditions, backend-phase-implementer", "packPattern": "`make tests_run`" },
    { "id": "make-test-full", "movedFrom": "validation-and-stop-conditions", "packPattern": "`make test-full`" },
    { "id": "make-test-coverage", "movedFrom": "validation-and-stop-conditions", "packPattern": "`make test-coverage` only when risk warrants it" },
    { "id": "rails-targeted-test", "movedFrom": "validation-and-stop-conditions, backend-phase-implementer", "packPattern": "bundle exec rails test path/to/test\\.rb" },
    { "id": "rubocop-touched", "movedFrom": "validation-and-stop-conditions, validation-runner", "packPattern": "`bundle exec rubocop` against touched backend files" },
    { "id": "bun-test", "movedFrom": "validation-and-stop-conditions, frontend-phase-implementer", "packPattern": "`bun run test`" },
    { "id": "bun-lint", "movedFrom": "validation-and-stop-conditions, frontend-phase-implementer", "packPattern": "`bun run lint`" },
    { "id": "bun-lint-styles", "movedFrom": "validation-and-stop-conditions, frontend-phase-implementer", "packPattern": "`bun run lint:styles`" },
    { "id": "bun-validate-css", "movedFrom": "validation-and-stop-conditions, frontend-phase-implementer", "packPattern": "`bun run validate:css`" },
    { "id": "bun-validate-all", "movedFrom": "validation-and-stop-conditions", "packPattern": "`bun run validate:all` only for broad changes" },
    { "id": "review-focus", "movedFrom": "qa-handoff-review", "packPattern": "service boundaries, CanCanCan, tenancy, i18n, Minitest" },
    { "id": "backend-standards", "movedFrom": "create-prd", "packPattern": "`BACKEND_STANDARDS\\.md`" }
  ]
}
